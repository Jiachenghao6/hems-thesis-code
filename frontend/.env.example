# Copy to .env.local for local work, or set these in the hosting platform's
# environment for a deployed build. Vite only exposes variables prefixed VITE_,
# and it inlines them into the bundle — never put a secret here.

# Backend origin. Leave unset locally to use http://localhost:8000.
VITE_API_BASE=https://your-backend-host

# Both come from the Prolific study page, after the study is created.
VITE_PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=XXXXXXXX
VITE_PROLIFIC_COMPLETION_CODE=XXXXXXXX
